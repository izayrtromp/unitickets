# Backend Environment Variables Example
PORT=5001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/unitickets"
DIRECT_URL="postgresql://user:password@localhost:5432/unitickets"

# Authentication
JWT_SECRET="your_super_secret_jwt_key_here"

# Frontend Integration
FRONTEND_URL=https://unitickets-six.vercel.app

# Email Delivery (SMTP)
EMAIL_USER=uniticketsapp@gmail.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_PORT=587
