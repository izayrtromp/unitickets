generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    // STUDENT, CLASS_REP, ADMIN
  createdAt    DateTime  @default(now())

  ticketsSubmitted Ticket[]  @relation("Submitter")
  ticketsAssigned  Ticket[]  @relation("Assignee")
  comments         Comment[]
  activities       Activity[]
  notifications    Notification[]
}

model Ticket {
  id          String    @id @default(uuid())
  title       String
  category    String
  description String
  priority    String    // LOW, MEDIUM, HIGH, URGENT
  status      String    @default("NEW") // NEW, IN_PROGRESS, WAITING, RESOLVED, CLOSED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  submitterId String
  submitter   User      @relation("Submitter", fields: [submitterId], references: [id])

  assignedToId String?
  assignedTo   User?    @relation("Assignee", fields: [assignedToId], references: [id])

  comments     Comment[]
  activities   Activity[]
  notifications Notification[]
}

model Comment {
  id        String   @id @default(uuid())
  ticketId  String
  userId    String
  content   String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model Activity {
  id        String   @id @default(uuid())
  ticketId  String
  userId    String
  action    String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  ticketId  String?
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  ticket    Ticket?  @relation(fields: [ticketId], references: [id])
}
