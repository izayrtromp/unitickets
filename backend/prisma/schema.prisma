generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  studentId    String?   @unique
  passwordHash String
  role         String    // STUDENT, CLASS_REP, ADMIN
  isActive     Boolean   @default(true)
  approvalStatus String  @default("APPROVED")
  isEmailVerified Boolean @default(true)
  verificationToken String?
  verificationTokenExpires DateTime?
  passwordResetToken String?
  passwordResetExpires DateTime?
  createdAt    DateTime  @default(now())
  verificationResendCount Int @default(0)
  verificationResendWindowStart DateTime?

  ticketsSubmitted Ticket[]  @relation("Submitter")
  ticketsAssigned  Ticket[]  @relation("Assignee")
  comments         Comment[]
  activities       Activity[]
  notifications    Notification[]
  tasksAssigned    Task[]    @relation("TaskAssignee")
  tasksCreated     Task[]    @relation("TaskCreator")
  meetingsCreated  Meeting[] @relation("MeetingCreator")
  agendaItemsAdded MeetingAgendaItem[] @relation("AgendaItemAdder")
}

model Ticket {
  id          String    @id @default(uuid())
  title       String
  category    String
  type        String    @default("STANDARD") // STANDARD, BUG, FEATURE_REQUEST, GENERAL_FEEDBACK, ACADEMIC
  description String
  priority    String    // LOW, MEDIUM, HIGH, URGENT
  status      String    @default("NEW") // NEW, IN_PROGRESS, WAITING, RESOLVED, CLOSED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  reopenCount Int       @default(0)
  lastReopenedAt DateTime?

  submitterId String
  submitter   User      @relation("Submitter", fields: [submitterId], references: [id])

  assignedToId String?
  assignedTo   User?    @relation("Assignee", fields: [assignedToId], references: [id])

  comments     Comment[]
  activities   Activity[]
  notifications Notification[]
  tasks        Task[]
  agendaItems  MeetingAgendaItem[]
}

model Comment {
  id        String   @id @default(uuid())
  ticketId  String
  userId    String
  content   String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model Activity {
  id        String   @id @default(uuid())
  ticketId  String
  userId    String
  action    String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  ticketId  String?
  commentId String?
  activityId String?
  targetSection String?
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  ticket    Ticket?  @relation(fields: [ticketId], references: [id])
}

model Task {
  id            String    @id @default(uuid())
  title         String
  description   String?
  status        String    @default("TODO") // TODO, IN_PROGRESS, DONE
  dueDate       DateTime?
  
  ticketId      String?
  ticket        Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  
  assignedToId  String
  assignedTo    User      @relation("TaskAssignee", fields: [assignedToId], references: [id])
  
  createdById   String
  createdBy     User      @relation("TaskCreator", fields: [createdById], references: [id])
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Meeting {
  id          String   @id @default(uuid())
  title       String
  meetingDate DateTime
  location    String?
  notes       String?
  
  createdById String
  createdBy   User     @relation("MeetingCreator", fields: [createdById], references: [id])
  
  agendaItems MeetingAgendaItem[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MeetingAgendaItem {
  id              String   @id @default(uuid())
  meetingId       String
  meeting         Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  
  ticketId        String
  ticket          Ticket   @relation(fields: [ticketId], references: [id])
  
  discussionNotes String?
  outcome         String?
  status          String   @default("PENDING") // PENDING, DISCUSSED, FOLLOW_UP_REQUIRED, RESOLVED
  
  addedById       String
  addedBy         User     @relation("AgendaItemAdder", fields: [addedById], references: [id])
  createdAt       DateTime @default(now())

  @@unique([meetingId, ticketId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  actorEmail  String?
  actorName   String?
  action      String
  targetType  String?
  targetId    String?
  targetLabel String?
  metadata    Json?
  createdAt   DateTime @default(now())
}

